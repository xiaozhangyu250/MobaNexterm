# The project lives on an exfat filesystem that DOES NOT support symbolic links.
# Both npm and pnpm normally create symlinks in node_modules/.bin/ — those calls
# fail with EPERM on exfat. Workarounds:
#
# 1) Always install with --no-bin-links (set below)
# 2) After install, run `node scripts/setup-bin-shims.cjs` to populate
#    node_modules/.bin/ with real-file shim scripts that exec the binary.
#
# Both of these are wrapped by `npm install`'s postinstall in package.json.

bin-links=false

# Avoid network jitter killing installs on slow links
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
