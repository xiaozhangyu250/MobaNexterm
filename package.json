{
  "name": "mobanexterm",
  "version": "0.1.1",
  "description": "A Linux-first SSH terminal and SFTP client built with Electron",
  "private": true,
  "author": "MobaNexterm",
  "license": "MIT",
  "homepage": "https://mobanexterm.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mobanexterm/mobanexterm.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run.cjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/run.cjs preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "rebuild": "electron-builder install-app-deps",
    "package:linux": "node scripts/package-linux.cjs",
    "dist:linux": "node scripts/package-linux.cjs",
    "postinstall": "node scripts/setup-bin-shims.cjs && (electron-builder install-app-deps || true)",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:electron": "npm run build && node tests/electron/smoke.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^14.0.0",
    "playwright-core": "^1.51.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
